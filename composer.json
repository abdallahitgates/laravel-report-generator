{
    "name": "abdalla/laravel-report-generator",
    "description": "Semantic-model report engine for Laravel: scan any database, build reports without SQL, run them at big-data scale.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "reports", "report-builder", "semantic-layer", "bi"],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.34|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Abdalla\\ReportGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abdalla\\ReportGenerator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abdalla\\ReportGenerator\\ReportGeneratorServiceProvider"
            ],
            "aliases": {
                "ReportGenerator": "Abdalla\\ReportGenerator\\Facades\\ReportGenerator"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
